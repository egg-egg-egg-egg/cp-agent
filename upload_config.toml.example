# 上传题目到 OJ 的凭据配置
# 复制为 upload_config.toml 并填写（该文件已在 .gitignore 中，不会提交）
#
# 解析优先级：命令行参数 > 本文件 > 环境变量
# （OJ_BASE_URL / OJ_USER / OJ_PASSWORD / OJ_KIND）

[oj]
host = "https://oj.ipachong.com"
# 这里只放占位符。真实用户名请写进 upload_config.toml（已被 gitignore）
# 或环境变量 OJ_USER —— 本文件会进公开仓库，不要填任何真实凭据。
user = "your_oj_username"
password = ""

# 导入接口类型，对应 HUSTOJ admin/problem_import_*.php
#   hydro → problem_import_hydro.php（本项目 export.py 产物，推荐）
#   qduoj → problem_import_qduoj.php（QDUOJ 导出的 json+testcase zip）
#   syzoj / hoj / tyvj / md / xml 同理
# 导入入口。这台 OJ 装了两代：
#   新一代（带后缀 2，挂在 admin/problem_import2.php，题面按 Markdown 渲染）→ 推荐
#   老一代 hydro / xml / qduoj …（把 HTML 题面当 markdown 文本处理，格式会散）
kind = "hydro2"
